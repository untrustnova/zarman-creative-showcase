# Deployment Preset for Nitro / TanStack Start
# Values: 'vercel', 'cloudflare-module', 'node-server'
# For Vercel deployment, set NITRO_PRESET=vercel
NITRO_PRESET=vercel

# Node Version hint for hosting platforms
NODE_VERSION=20.x

# Public Website URL
VITE_SITE_URL=https://zarman-creative-showcase.vercel.app

# Studio Brand Information
VITE_STUDIO_NAME="Zarman Studio"
VITE_STUDIO_TAGLINE="Independent Creative Agency"

# Contact Channels
VITE_CONTACT_PHONE="+62 895 1930 5701"
VITE_CONTACT_EMAIL="zarmanstudio@gmail.com"
VITE_CONTACT_INSTAGRAM="https://instagram.com/zarman.creative"
